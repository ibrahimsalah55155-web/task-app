{
  "id": "com.multimediaai.podcaststudio",
  "name": "Multimedia & AI Group",
  "version": "0.4.3",
  "main": "index.html",
  "manifestVersion": 5,
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request",
    "clipboard": "readAndWrite",
    "network": {
      "domains": "all"
    },
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".vbs"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "studioPanel",
      "type": "panel",
      "label": {
        "default": "Multimedia & AI Group",
        "ar": "مجموعة الملتيميديا والذكاء الاصطناعي"
      },
      "minimumSize": {
        "width": 280,
        "height": 360
      },
      "maximumSize": {
        "width": 2000,
        "height": 3000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 640
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 720
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark",
            "medium"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.svg",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.svg",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark",
        "medium",
        "lightest",
        "light",
        "all"
      ],
      "species": [
        "pluginList"
      ]
    }
  ]
}
